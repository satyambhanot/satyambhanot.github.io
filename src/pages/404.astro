---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="Page not found" description="This page doesn't exist.">
  <section class="lost wrap">
    <p class="eyebrow">404</p>
    <h1>Lost the <em>light.</em></h1>
    <p>This page doesn't exist, or it moved when the site was rebuilt.</p>
    <div class="actions">
      <a class="btn btn--primary" href="/"><Icon name="back" />Back home</a>
      <a class="btn" href="/#projects">Browse projects</a>
    </div>
  </section>
</Layout>
