---
// Generated artwork for a project card, drawn in SVG. The style depends on the
// project's `type`, and the details come from its name, so every card is
// different but they all look related. Colours come from the theme.
interface Props {
  type: string;
  seed: string;
}

const { type, seed } = Astro.props;

// A small seeded random number generator, so the same project always gets the same picture.
function random(text: string) {
  let h = 1779033703 ^ text.length;
  for (let i = 0; i < text.length; i++) {
    h = Math.imul(h ^ text.charCodeAt(i), 3432918353);
    h = (h << 13) | (h >>> 19);
  }
  let a = h >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = random(seed);
const range = (min: number, max: number) => min + rand() * (max - min);
const clamp = (n: number, min: number, max: number) => Math.min(max, Math.max(min, n));

const kind = /desktop/i.test(type)
  ? 'desktop'
  : /machine|ml|learning/i.test(type)
  ? 'ml'
  : /system/i.test(type)
    ? 'systems'
    : /data/i.test(type)
      ? 'data'
      : /mobile|android/i.test(type)
        ? 'mobile'
        : /backend|api|service/i.test(type)
          ? 'backend'
          : 'rings';

// Machine learning: a scatter of points, a few rare outliers, one detected and boxed.
const centers = Array.from({ length: 3 }, () => ({ x: range(90, 310), y: range(70, 180) }));
const points = Array.from({ length: 84 }, () => {
  const c = centers[Math.floor(rand() * centers.length)];
  return {
    x: clamp(c.x + (rand() + rand() + rand() - 1.5) * 90, 14, 386),
    y: clamp(c.y + (rand() + rand() + rand() - 1.5) * 64, 14, 236),
  };
});
const outliers = Array.from({ length: 4 }, () => ({ x: range(40, 330), y: range(70, 205) }));
const target = outliers[0];
const s = 17;
const l = 7;
const brackets = [
  `M${target.x - s},${target.y - s + l}V${target.y - s}H${target.x - s + l}`,
  `M${target.x + s - l},${target.y - s}H${target.x + s}V${target.y - s + l}`,
  `M${target.x + s},${target.y + s - l}V${target.y + s}H${target.x + s - l}`,
  `M${target.x - s + l},${target.y + s}H${target.x - s}V${target.y + s - l}`,
].join('');
const score = (0.9 + rand() * 0.09).toFixed(2);

// Systems: a grid of memory blocks with a chain of allocated blocks linked together.
const cols = 14;
const rows = 7;
const cell = 22;
const gap = 5;
const gridX = (400 - (cols * (cell + gap) - gap)) / 2;
const gridY = (250 - (rows * (cell + gap) - gap)) / 2;
const blocks = Array.from({ length: cols * rows }, (_, i) => ({
  x: gridX + (i % cols) * (cell + gap),
  y: gridY + Math.floor(i / cols) * (cell + gap),
  used: rand() < 0.26,
}));
let cx = Math.floor(range(1, 4));
let cy = Math.floor(range(0, rows - 1));
const chain: number[] = [];
for (let step = 0; step < 7; step++) {
  chain.push(cy * cols + cx);
  if (rand() < 0.62 || cy >= rows - 1) cx = Math.min(cols - 1, cx + Math.floor(range(1, 3)));
  else cy += 1;
}
const chainCells = [...new Set(chain)];
const chainPath = chainCells
  .map((i, n) => `${n ? 'L' : 'M'}${blocks[i].x + cell / 2},${blocks[i].y + cell / 2}`)
  .join('');

// Data: bars with a trend line over the top.
const barCount = 14;
const barW = 18;
const barGap = 8;
const barX = (400 - (barCount * (barW + barGap) - barGap)) / 2;
const bars = Array.from({ length: barCount }, (_, i) => {
  const h = clamp(48 + i * 4 + range(-26, 34), 30, 160);
  return { x: barX + i * (barW + barGap), h, y: 214 - h };
});
const peak = bars.reduce((best, b, i) => (b.h > bars[best].h ? i : best), 0);
const trend = bars.map((b, i) => `${i ? 'L' : 'M'}${b.x + barW / 2},${b.y - 16}`).join('');

const corners = [
  [16, 16],
  [384, 16],
  [16, 234],
  [384, 234],
];
---
<svg viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  {corners.map(([x, y]) => <path class="art-nl" d={`M${x - 5},${y}H${x + 5}M${x},${y - 5}V${y + 5}`} />)}

  {kind === 'ml' && (
    <>
      {points.map((p) => <circle class="art-n" cx={p.x} cy={p.y} r="2.2" />)}
      {outliers.map((p) => <circle class="art-a" cx={p.x} cy={p.y} r="3.8" />)}
      <circle class="art-al art-pulse" cx={target.x} cy={target.y} r="3.8" style="stroke-width:1.4" />
      <path class="art-al" d={brackets} style="stroke-width:1.8" />
      <rect class="art-a" x={clamp(target.x + s + 6, 0, 346)} y={target.y - s - 2} width="38" height="15" rx="5" />
      <text x={clamp(target.x + s + 6, 0, 346) + 19} y={target.y - s + 9} text-anchor="middle" style="font:600 9px var(--mono);fill:var(--on-accent)">{score}</text>
    </>
  )}

  {kind === 'systems' && (
    <>
      {blocks.map((b, i) =>
        chainCells.includes(i) ? (
          <rect class="art-a" x={b.x} y={b.y} width={cell} height={cell} rx="5" />
        ) : b.used ? (
          <rect class="art-n" x={b.x} y={b.y} width={cell} height={cell} rx="5" style="opacity:.55" />
        ) : (
          <rect class="art-nl" x={b.x} y={b.y} width={cell} height={cell} rx="5" />
        ),
      )}
      <path class="art-al art-flow" d={chainPath} style="stroke:var(--on-accent);stroke-width:1.6" />
    </>
  )}

  {kind === 'data' && (
    <>
      <path class="art-nl" d="M16,214H384" />
      {bars.map((b, i) => (
        <rect class={i === peak ? 'art-a' : 'art-n'} x={b.x} y={b.y} width={barW} height={b.h} rx="4" style={i === peak ? '' : 'opacity:.5'} />
      ))}
      <path class="art-al" d={trend} />
      {bars.map((b, i) => <circle class="art-a" cx={b.x + barW / 2} cy={b.y - 16} r={i === bars.length - 1 ? 4.5 : 2.6} />)}
    </>
  )}

  {kind === 'desktop' && (
    <>
      <rect class="art-nl" x="58" y="34" width="284" height="182" rx="13" style="stroke-width:2" />
      <path class="art-nl" d="M58,60H342M118,60V216" />
      {[0, 1, 2].map((i) => <circle class={i === 0 ? 'art-a' : 'art-n'} cx={76 + i * 14} cy="47" r="3.6" />)}
      {[0, 1, 2, 3].map((i) => <rect class="art-n" x="70" y={76 + i * 22} width={i === 1 ? 36 : 28} height="7" rx="3.5" style={i === 1 ? 'fill:var(--accent)' : 'opacity:.6'} />)}
      <rect class="art-n" x="134" y="74" width="60" height="7" rx="3.5" />
      <rect class="art-n" x="222" y="74" width="40" height="7" rx="3.5" style="opacity:.5" />
      <rect class="art-n" x="284" y="74" width="40" height="7" rx="3.5" style="opacity:.5" />
      {[0, 1, 2, 3, 4].map((i) => (
        <>
          <path class="art-nl" d={`M134,${96 + i * 22}H326`} style="opacity:.6" />
          <rect class="art-n" x="134" y={104 + i * 22 - 5} width={50 + ((i * 17) % 28)} height="6" rx="3" style="opacity:.55" />
          <rect class="art-n" x="222" y={104 + i * 22 - 5} width="32" height="6" rx="3" style="opacity:.35" />
        </>
      ))}
      <rect x="130" y="125" width="200" height="20" rx="6" style="fill:var(--accent);opacity:.2" />
      <rect class="art-a" x="284" y="186" width="44" height="18" rx="9" />
    </>
  )}

  {kind === 'mobile' && (
    <>
      <rect class="art-nl" x="-24" y="150" width="70" height="70" rx="18" transform="rotate(-14 10 185)" />
      <rect class="art-nl" x="354" y="40" width="56" height="56" rx="16" transform="rotate(12 382 68)" />
      <circle class="art-a art-pulse" cx="330" cy="190" r="7" />
      <rect class="art-nl" x="145" y="20" width="110" height="214" rx="26" style="stroke-width:2" />
      <rect class="art-n" x="184" y="30" width="32" height="7" rx="3.5" />
      {[0, 1, 2, 3].map((i) => (
        <>
          <circle class="art-n" cx="170" cy={74 + i * 34} r="9" />
          <rect class="art-n" x="186" y={67 + i * 34} width={i % 2 ? 44 : 56} height="6" rx="3" />
          <rect class="art-n" x="186" y={78 + i * 34} width="34" height="5" rx="2.5" style="opacity:.5" />
        </>
      ))}
      <rect class="art-a" x="165" y="204" width="70" height="20" rx="10" />
    </>
  )}

  {kind === 'backend' && (
    <>
      <path class="art-nl art-flow" d="M104,125H146M236,125C262,125 262,76 286,76M236,125C262,125 262,174 286,174" />
      {[
        { x: 34, y: 106, label: 'client', accent: false },
        { x: 146, y: 106, label: 'api', accent: true },
        { x: 286, y: 57, label: 'db', accent: false },
        { x: 286, y: 155, label: 'worker', accent: false },
      ].map((n) => (
        <>
          <rect class={n.accent ? 'art-a' : 'art-nl'} x={n.x} y={n.y} width="80" height="38" rx="11" />
          <text x={n.x + 40} y={n.y + 23} text-anchor="middle" style={n.accent ? 'font:600 10px var(--mono);fill:var(--on-accent)' : ''} class={n.accent ? '' : 'art-text'}>{n.label}</text>
        </>
      ))}
    </>
  )}

  {kind === 'rings' && (
    <>
      {[30, 60, 90, 120].map((r) => <circle class="art-nl" cx="200" cy="125" r={r} />)}
      <circle class="art-a art-pulse" cx="200" cy="125" r="8" />
    </>
  )}
</svg>
