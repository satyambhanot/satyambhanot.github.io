---
interface Props {
  name: 'brand' | 'arrow' | 'back' | 'external' | 'sun' | 'moon' | 'copy' | 'mail' | 'file';
  class?: string;
}

const { name, class: className } = Astro.props;
---
{name === 'brand' ? (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect x="1" y="1" width="10" height="10" rx="3" fill="currentColor" />
    <rect x="13" y="1" width="10" height="10" rx="3" fill="#cff24a" />
    <rect x="1" y="13" width="10" height="10" rx="3" fill="currentColor" />
    <rect x="13" y="13" width="10" height="10" rx="3" fill="currentColor" />
  </svg>
) : (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
    {name === 'back' && <path d="M19 12H5M11 6l-6 6 6 6" />}
    {name === 'external' && <path d="M7 17 17 7M8 7h9v9" />}
    {name === 'sun' && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </>
    )}
    {name === 'moon' && <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />}
    {name === 'copy' && (
      <>
        <rect x="9" y="9" width="11" height="11" rx="2" />
        <path d="M5 15V6a2 2 0 0 1 2-2h8" />
      </>
    )}
    {name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m4 7 8 6 8-6" />
      </>
    )}
    {name === 'file' && (
      <>
        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
        <path d="M14 3v5h5M9 13h6M9 17h6" />
      </>
    )}
  </svg>
)}
