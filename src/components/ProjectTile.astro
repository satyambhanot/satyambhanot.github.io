---
// A project tile on the home page.
// If the project's Markdown file has a write-up, the whole tile links to its page.
// If not, the tile shows the takeaway instead, so there's nothing to click through to.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  big?: boolean;
}

const { project, big = false } = Astro.props;
const { title, summary, type, period, context, stack, cover, takeaway, repo } = project.data;
const hasPage = Boolean(project.body?.trim());
const Tag = hasPage ? 'a' : 'article';
const titleId = `${project.id}-title`;
---
<Tag
  class:list={['tile', 'project-tile', big && 'project-tile--big tile--inverse c-2 r-2']}
  href={hasPage ? `/projects/${project.id}/` : undefined}
  aria-labelledby={titleId}
>
  {big && cover && (
    <div class="project-cover">
      <Image src={cover.src} alt="" widths={[640, 960, 1280]} sizes="(max-width: 960px) 100vw, 620px" loading="eager" />
    </div>
  )}
  <div class="project-body">
    <p class="label">{[type, period ?? context].filter(Boolean).join(' · ')}</p>
    <h3 class="tile-title" id={titleId}>{title}</h3>
    <p class="tile-text">{summary}</p>
    {!hasPage && takeaway && <p class="takeaway"><span class="label">What it taught me</span> {takeaway}</p>}
    <p class="stack">{stack.slice(0, 4).map((s) => <span>{s}</span>)}</p>
    {hasPage && <p class="read-more">Read the case study <span class="arrow"><Icon name="arrow" /></span></p>}
    {!hasPage && repo && <a class="text-link" href={repo}>View code <Icon name="external" /></a>}
  </div>
</Tag>
