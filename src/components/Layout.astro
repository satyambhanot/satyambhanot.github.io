---
// The page shell: <head> tags, the header with navigation, and the footer.
import Icon from './Icon.astro';
import { profile, education } from '../site';
import '../styles.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = profile.description } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/social-preview.png', Astro.site);

// Tells search engines who this site is about. Built from site.ts so it never goes stale.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: Astro.site,
  jobTitle: profile.role,
  homeLocation: profile.location,
  alumniOf: education.map((d) => ({ '@type': 'CollegeOrUniversity', name: d.school })),
  sameAs: [profile.github, profile.linkedin],
};

// On the home page only: tells Google the site's name, so results show "Satyam Bhanot"
// instead of the domain.
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: profile.name,
  alternateName: `${profile.name} Portfolio`,
  url: Astro.site,
};
const isHome = Astro.url.pathname === '/';
const city = profile.location.split(',')[0];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico?v=5" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=5" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=5" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(website)} />}
    <!-- Pick the theme before the page paints, so it never flashes the wrong colours.
         Also marks the page as script-enabled, and shows everything if the main script never starts. -->
    <script is:inline>
      {
        let saved;
        try { saved = localStorage.getItem('theme'); } catch {}
        document.documentElement.dataset.theme =
          saved === 'light' || saved === 'dark' ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.classList.add('js');
        setTimeout(function () {
          if (!window.__siteReady) document.documentElement.classList.add('no-reveal');
        }, 3000);
      }
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="ambient" aria-hidden="true">
      <div class="dots"></div>
      <div class="lamp"></div>
    </div>
    <div class="progress" aria-hidden="true"></div>

    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/" aria-label={`${profile.name}, home`}>
          <Icon name="brand" class="brand-mark" />
          <span class="brand-name">{profile.name}</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/#projects">Work</a>
          <a class="nav-optional" href="/#approach">Approach</a>
          <a href="/#experience">Experience</a>
          <a href="/#contact">Contact</a>
          {profile.resume && <a class="nav-optional" href={profile.resume}>Résumé</a>}
          <a class="btn btn--primary btn--sm nav-cta" href={`mailto:${profile.email}`}>Email me</a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch between light and dark theme">
            <Icon name="moon" class="icon-moon" />
            <Icon name="sun" class="icon-sun" />
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>© {new Date().getFullYear()} {profile.name}</p>
        <span class="clock" data-clock data-tz={profile.timezone} data-city={city} hidden></span>
        <p class="footer-links">
          <a href={profile.linkedin}>LinkedIn</a>
          <a href={profile.github}>GitHub</a>
          <a href="#top">Back to top ↑</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
